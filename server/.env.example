# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Database Configuration
DATABASE_URL=postgresql://localhost:5432/claude_session_manager

# Handoff Configuration
HANDOFF_THRESHOLD_PERCENT=20

# Logging
LOG_LEVEL=debug

# Session Analyzer (Claude SDK)
# Model for AI summaries/analysis (cheapest to most capable):
# - claude-3-5-haiku-20241022 (fastest, cheapest - default)
# - claude-sonnet-4-20250514 (balanced)
# - claude-opus-4-20250514 (most capable)
ANALYZER_MODEL=claude-3-5-haiku-20241022

# API Key (optional, required for remote access)
# Generate with: openssl rand -hex 32
# API_KEY=your-32-character-min-api-key-here

# Workmux bridge: how often to poll workmux agent state (ms), and where the
# agent JSON lives (defaults to ~/.local/state/workmux/agents).
WORKMUX_POLL_MS=1000
# WORKMUX_AGENTS_DIR=/Users/you/.local/state/workmux/agents

# APNs (Apple Push Notification service) — for iOS push + Live Activity updates.
# Set all three of KEY_ID / TEAM_ID / KEY_PATH to enable sending; leave any
# unset and the server boots normally but skips push. Create the .p8 auth key in
# Apple Developer > Certificates, Identifiers & Profiles > Keys.
# APNS_KEY_ID=ABCDE12345
# APNS_TEAM_ID=647Y8SN38G
# APNS_KEY_PATH=./.secrets/AuthKey_ABCDE12345.p8
APNS_BUNDLE_ID=com.claudepm.ios
# 'sandbox' for development builds installed from Xcode; 'production' for
# TestFlight/App Store or a production-provisioned build.
APNS_ENVIRONMENT=sandbox
