<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>UIAppFonts</key>
    <array>
        <string>JetBrainsMonoNerdFontMono-Regular.ttf</string>
        <string>JetBrainsMonoNerdFontMono-Bold.ttf</string>
    </array>
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <true/>
    </dict>
    <!-- Enables ActivityKit Live Activities (lock-screen / Dynamic Island). -->
    <key>NSSupportsLiveActivities</key>
    <true/>
    <!-- Allows remote pushes to wake the app / update Live Activities in background. -->
    <key>UIBackgroundModes</key>
    <array>
        <string>remote-notification</string>
    </array>
</dict>
</plist>
